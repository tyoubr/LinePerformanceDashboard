@{
    ViewData["Title"] = "Line Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Line Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>

    <style>

        body {
            background: #0f172a;
            color: white;
            padding: 10px;
        }

        h3 {
            text-align: center;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .dashboard-card {
            background: #1e293b;
            padding: 4px;
            border-radius: 8px;
            text-align: center;
        }

            .dashboard-card h2 {
                color: #facc15;
                font-size: 16px; /* text size increase */
                font-weight: bold;
            }

        .table-dark-custom {
            background: #1e293b;
            color: white;
        }

            .table-dark-custom thead th {
                background: #111827;
                color: #facc15;
            }

        .row-title {
            background: #111827;
            color: #facc15;
            font-weight: bold;
        }

        .card {
            background: #1e293b !important;
            border: none;
        }

        /* FULL SCREEN LOADER */
        #pageLoader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.95);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 99999;
            cursor: wait;
        }

        .spinner {
            width: 55px;
            height: 55px;
            border: 5px solid #334155;
            border-top: 5px solid #facc15;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0%{
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }

        }

        .loader-text {
            margin-top: 15px;
            color: #facc15;
            font-weight: bold;
            font-size: 16px;
        }

        body.loading {
            cursor: wait;
            overflow: hidden;
        }

        .table-scroll {
            max-height: 350px;
            overflow-y: auto;
        }

        /* sticky header FIX (no overlap anymore) */
        .table thead th {
            position: sticky;
            top: 0;
            background: #111827;
            color: #facc15;
            z-index: 999;
        }

        /* table alignment */
        .table td, .table th {
            text-align: center;
            vertical-align: middle;
        }

        .table {
            margin-bottom: 0.5rem !important;
        }

        .table-sm th,
        .table-sm td {
            padding: 3px 6px !important;
            font-size: 14px;
            line-height: 1.1;
        }

    </style>
</head>

<body>
    <div id="pageLoader">
        <div class="spinner"></div>
        <div class="loader-text">Loading Dashboard...</div>
    </div>

    <div class="d-flex align-items-center justify-content-center position-relative mt-1">

        <!-- Left Arrow Home Button -->
        <a href="/OperatorDetails/OperatorDetailsList"
           class="btn btn-sm btn-warning position-absolute start-0 ms-2">
            ←
        </a>

        <!-- Title -->
        <h3 class="mb-2 text-center">
            Line Performance Dashboard
        </h3>

    </div>

        <!-- ================= CARDS ================= -->
    <div class="row g-1">

            <div class="col-md-2"><div class="dashboard-card"><h2 id="dateProd">0</h2><p>Prod. Date</p></div></div>
            <div class="col-md-1"><div class="dashboard-card"><h2 id="lineNo">0</h2><p>Line No.</p></div></div>
            <div class="col-md-2"><div class="dashboard-card"><h2 id="itemName">0</h2><p>Item Name</p></div></div>
            <div class="col-md-2"><div class="dashboard-card"><h2 id="buyerName">0</h2><p>Buyer Name</p></div></div>
            <div class="col-md-2"><div class="dashboard-card"><h2 id="styleRef">0</h2><p>Style Ref.</p></div></div>
            <div class="col-md-1"><div class="dashboard-card"><h2 id="avgSmv">0</h2><p>SMV</p></div></div>
            <div class="col-md-2"><div class="dashboard-card"><h2 id="manPower">0</h2><p>Man Power</p></div></div>

        </div>

        <!-- ================= HOURLY TABLE (KEEP ORIGINAL) ================= -->
        <div class="table-responsive mt-1">

            <table class="table table-bordered table-dark-custom">

                <thead>
                    <tr class="text-center">
                        <th>Hourly</th>
                        <th>08-09</th>
                        <th>09-10</th>
                        <th>10-11</th>
                        <th>11-12</th>
                        <th>12-01</th>
                        <th>Lunch Hour</th>
                        <th>02-03</th>
                        <th>03-04</th>
                        <th>04-05</th>
                        <th>05-06</th>
                        <th>06-07</th>
                    </tr>
                </thead>

                <tbody id="prodTableBody"></tbody>

            </table>

        </div>

        <!-- ================= CHART + OPERATOR TABLE ================= -->
        <div class="row mt-0">

            <!-- LEFT: BAR CHART -->
            <div class="col-md-6">

                <div class="card bg-dark border-secondary h-100">

                    <div class="card-header text-center text-warning fw-bold">
                        Hourly Efficiency Graph
                    </div>

                    <div class="card-body" style="height:350px;">
                        <canvas id="efficiencyChart"></canvas>
                    </div>

                </div>

            </div>

            <!-- OPERATOR Details TABLE -->
            <div class="col-md-6">

                <div class="card bg-dark border-secondary h-100">

                    <div class="card-header text-center text-warning fw-bold">
                        Operators Details
                    </div>

                    <div class="card-body p-0 table-scroll">

                        <table class="table table-dark table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Operator Name</th>
                                    <th>Process</th>
                                    <th>Cycle</th>
                                    <th>Capacity</th>
                                </tr>
                            </thead>

                            <tbody id="operatorTableBody"></tbody>
                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <script>

        let chart = null;

        async function apiGet(url){

    const response = await fetch(
        `${url}?t=${new Date().getTime()}`,
        {
            cache: "no-store"
        });

    return await response.json();
}

        /* ================= DASHBOARD ================= */

        async function loadDashboard(){
            const r = await apiGet("/LinePerformanceDashboard/GetDashboardCardData");
            const d = Array.isArray(r) ? r[0] : r;

            if(!d) return;
            dateProd.innerText = d.date? new Date(d.date).toLocaleDateString(): "-";
            lineNo.innerText = d.lineName ?? "-";
            itemName.innerText = d.itemName ?? "-";
            buyerName.innerText = d.buyerName ?? "-";
            styleRef.innerText = d.styleRefNo ?? "-";
            avgSmv.innerText = d.avgSmv ?? 0;
            manPower.innerText = d.manPower ?? 0;
        }

        /* ================= HOURLY TABLE (KEEP SAME) ================= */

       async function loadTable() {

    const r = await apiGet("/LinePerformanceDashboard/GetLineWiseProduction");
    const d = Array.isArray(r) ? r[0] : r;

    if (!d) return;

    const target = Number(d.targeT_PER_HOUR || 0);
    const smv = Number(d.avgSmv || 0);
    const manpower = Number(d.manPower || 1); // avoid divide by zero

    // ================= ACHIEVED =================
    let achieved = [
        d.one, d.two, d.three, d.four, d.five,
        d.six, d.seven, d.eight, d.nine, d.ten, d.eleven
    ].map(x => Number(x || 0));

    // 🍛 Lunch Hour (index 5) = 0
    achieved[5] = 0;

    // ================= EFFICIENCY (REAL FORMULA) =================
    const efficiencies = achieved.map(x =>
        manpower > 0
            ? +((((x * smv) / (manpower * 60)) * 100).toFixed(1))
            : 0
    );

    let html = "";

    // ================= TARGET ROW =================
    html += `<tr>
        <td class="row-title">Target</td>
        ${achieved.map((_, index) =>
            `<td>${index === 5 ? 0 : target}</td>`
        ).join("")}
    </tr>`;

    // ================= ACHIEVED ROW =================
    html += `<tr>
        <td class="row-title">Achieved</td>
        ${achieved.map(x => `<td>${x}</td>`).join("")}
    </tr>`;

    // ================= EFFICIENCY ROW =================
    html += `<tr>
        <td class="row-title">Efficiency %</td>
        ${efficiencies.map(x => `<td>${x}%</td>`).join("")}
    </tr>`;

    prodTableBody.innerHTML = html;

            drawChart(target, achieved, smv, manpower);
}

        /* ================= OPERATOR TABLE ================= */

        async function loadOperatorTable() {

            try {
                const res = await apiGet("/LinePerformanceDashboard/GetOperatorDetails");

                console.log("Operator API RAW:", res);

                const data = Array.isArray(res) ? res : [];

                let html = "";

                data.forEach((x) => {

                    const cycle = Number(x.avg_CYCLE || 0);
                    const cap = Number(x.capacity_HR || 0);

                    const score = cycle > 0 ? (cap / cycle).toFixed(2) : 0;

                    html += `
                        <tr>
                            <td>${x.name ?? "-"}</td>
                            <td>${x.process_NAME ?? "-"}</td>
                            <td>${cycle.toFixed(2)}</td>
                            <td>${cap}</td>
                        </tr>
                    `;
                });

                document.getElementById("operatorTableBody").innerHTML = html;

            } catch (e) {
                console.error("Operator Load Error:", e);
            }
        }

        /* ================= CHART ================= */

                function drawChart(target, achieved, smv, manpower) {

            const labels = [
                "08-09","09-10","10-11","11-12","12-01",
                "01-02","02-03","03-04","04-05","05-06","06-07"
            ];

            smv = Number(smv || 0);
            manpower = Number(manpower || 1);

            const data = achieved.map(x => {
                x = Number(x || 0);

                return manpower > 0
                    ? +((((x * smv) / (manpower * 60)) * 100).toFixed(1))
                    : 0;
            });

            const colors = data.map(v => {
                if (v < 25) return "#ef4444";
                if (v <= 75) return "#facc15";
                return "#22c55e";
            });

            const ctx = document.getElementById("efficiencyChart");

            if (chart) chart.destroy();

            chart = new Chart(ctx, {
                type: "bar",
                data: {
                    labels,
                    datasets: [{
                        data,
                        backgroundColor: colors,
                        borderColor: colors,
                        borderWidth: 1,
                        borderRadius: 0
                    }]
                },

                plugins: [ChartDataLabels],

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {
                        legend: { display: false },

                        // TITLE (optional nice look)
                        title: {
                            display: true,
                            text: "Hourly Efficiency (%)",
                            color: "#fff",
                            font: {
                                size: 16,
                                weight: "bold"
                            }
                        },

                        datalabels: {
                            color: "#fff",
                            anchor: "end",
                            align: "end",
                            formatter: v => v + "%"
                        }
                    },

                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            ticks: {
                                color: "#fff"
                            },
                            title: {
                                display: true,
                                text: "Efficiency %",
                                color: "#fff",
                                font: {
                                    weight: "bold"
                                }
                            }
                        },

                        x: {
                            ticks: {
                                color: "#fff"
                            },
                            title: {
                                display: true,
                                text: "Hourly",
                                color: "#fff",
                                font: {
                                    weight: "bold"
                                }
                            }
                        }
                    }
                }
            });
        }

        async function loadTopOperators() {

            try {
                const res = await apiGet("/LinePerformanceDashboard/GetOperatorDetails");

                const data = Array.isArray(res) ? res : [];

                let html = "";

                data.forEach((x, i) => {

                    const cycle = Number(x.avg_CYCLE || 0);
                    const cap = Number(x.capacity_HR || 0);

                    const score = cap > 0 ? ((cap / (cycle * 100)) * 100).toFixed(2) : 0;

                    html += `
                        <tr>
                            <td>${x.name ?? "-"}</td>
                            <td>${x.process_NAME ?? "-"}</td>
                            <td>${avg_CYCLE.toFixed(2)}</td>
                            <td>${capacity_HR}</td>
                        </tr>
                    `;
                });

                document.getElementById("operatorTableBody").innerHTML = html;

            } catch (e) {
                console.error("Operator Load Error:", e);
            }
        }
                function showLoader() {
            document.getElementById("pageLoader").style.display = "flex";
            document.body.classList.add("loading");
        }

        function hideLoader() {
            document.getElementById("pageLoader").style.display = "none";
            document.body.classList.remove("loading");
        }
                async function refreshDashboard() {

        try {

        console.log("Refreshing Dashboard:", new Date());

        await loadDashboard();
        await loadTable();
        await loadOperatorTable();

    }
    catch (e) {
        console.error("Auto Refresh Error:", e);
    }
    function updateRefreshTime() {

    const now = new Date();

    document.getElementById("lastRefresh").innerText =
        "Last Refresh: " +
        now.toLocaleTimeString();
}

async function refreshDashboard() {

    try {

        console.log(
            "Refreshing Dashboard:",
            new Date().toLocaleTimeString()
        );

        await loadDashboard();
        await loadTable();
        await loadOperatorTable();

        updateRefreshTime();

    }
    catch (e) {

        console.error(
            "Auto Refresh Error:",
            e
        );
        }
    }
}

        /* ================= INIT ================= */


document.addEventListener("DOMContentLoaded", async () => {

    showLoader();

    try {

        await loadDashboard();
        await loadTable();
        await loadOperatorTable();

        updateRefreshTime();

        console.log("Dashboard Loaded");

        // Refresh every 1 minute
        setInterval(async () => {

            await refreshDashboard();

        }, 60000);

    }
    catch (e) {

        console.error("Load Error:", e);
    }
    finally {

        hideLoader();
    }
});
    </script>

</body>
</html>