@model IEnumerable<LinePerformanceDashboard.Models.TblOperatorDetail>

@{
    ViewData["Title"] = "Operator Detail List";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;

    int pageSize = 15;

    int sl = (currentPage - 1) * pageSize;

    string search = ViewBag.Search ?? "";
}

<h2>Operator Detail List</h2>

<p class="text-muted" id="totalCount">
    Total Operator Details:
    <strong>@ViewBag.totalOperatorDetails</strong>
</p>

<div class="d-flex justify-content-between align-items-center mb-3">

    <!-- Search -->
    <div class="col-md-4 p-0">

        <input type="text"
               id="searchBox"
               value="@search"
               class="form-control"
               placeholder="Search Operator / Process" />

    </div>

    <!-- Buttons -->
    <div>

        <a asp-controller="OperatorDetails"
           asp-action="Create"
           class="btn btn-primary me-2">
            Create
        </a>

        <a asp-controller="OperatorDetails"
           asp-action="OperatorDetailsList"
           class="btn btn-secondary">
            Back
        </a>

    </div>

</div>


<!-- ===================================================== -->
<!-- TABLE -->
<!-- ===================================================== -->

<div id="operatorTable">

    <div class="table-responsive">

        <table class="table table-bordered table-striped table-hover">

            <thead class="table-dark">

                <tr>
                    <th>SL</th>
                    <th>Prod. Date</th>
                    <th>Operator Name</th>
                    <th>Line No.</th>
                    <th>Process Name</th>
                    <th>Avg. Cycle</th>
                    <th>Capacity/Hr</th>
                    <th>Remarks</th>
                    <th class="text-center">Actions</th>
                </tr>

            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        sl++;

                        <tr>

                            <!-- SL -->
                            <td>
                                @sl
                            </td>

                            <!-- Production Date -->
                            <td>
                                @(item.ProdDate != null
                                                        ? Convert.ToDateTime(item.ProdDate)
                                                        .ToString("dd-MMM-yyyy")
                                                        : "")
                    </td>

                            <!-- Operator Name -->
                            <td>
                                @item.Name
                            </td>

                            <!-- Line -->
                            <td>
                                @item.LineNo
                            </td>

                            <!-- Process -->
                            <td>
                                @item.ProcessName
                            </td>

                            <!-- Average Cycle -->
                            <td>
                                @item.AvgCycle
                            </td>

                            <!-- Capacity -->
                            <td>
                                @item.CapacityHr
                            </td>

                            <!-- Remarks -->
                            <td>
                                @item.Remark
                            </td>

                            <!-- Actions -->
                            <td class="text-center">

                                <a asp-controller="OperatorDetails"
                                   asp-action="Edit"
                                   asp-route-id="@item.Oid"
                                   class="btn btn-success btn-sm me-1">
                                    Edit
                                </a>

                                <a asp-controller="OperatorDetails"
                                   asp-action="Delete"
                                   asp-route-id="@item.Oid"
                                   class="btn btn-danger btn-sm">
                                    Delete
                                </a>

                            </td>

                        </tr>
                                }
                }
                else
                {
                    <tr>

                        <td colspan="9"
                            class="text-center text-danger">

                            No Data Found

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


<!-- ===================================================== -->
<!-- PAGINATION -->
<!-- ===================================================== -->
@if (totalPages > 0)
{
    <nav aria-label="Operator Detail Pagination">

        <ul class="pagination justify-content-center">

            <!-- PREVIOUS -->
            @if (currentPage > 1)
            {
                <li class="page-item">

                    <a class="page-link"
                       asp-controller="OperatorDetails"
                       asp-action="OperatorDetailsList"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-pageSize="@pageSize"
                       asp-route-search="@search">

                        Previous

                    </a>

                </li>
            }
            else
            {
                <li class="page-item disabled">

                    <span class="page-link">
                        Previous
                    </span>

                </li>
            }


            <!-- PAGE NUMBERS -->
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">

                    <a class="page-link"
                       asp-controller="OperatorDetails"
                       asp-action="OperatorDetailsList"
                       asp-route-page="@i"
                       asp-route-pageSize="@pageSize"
                       asp-route-search="@search">

                        @i

                    </a>

                </li>
            }


            <!-- NEXT -->
            @if (currentPage < totalPages)
            {
                <li class="page-item">

                    <a class="page-link"
                       asp-controller="OperatorDetails"
                       asp-action="OperatorDetailsList"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-pageSize="@pageSize"
                       asp-route-search="@search">

                        Next

                    </a>

                </li>
            }
            else
            {
                <li class="page-item disabled">

                    <span class="page-link">
                        Next
                    </span>

                </li>
            }

        </ul>

    </nav>
}


<!-- ===================================================== -->
<!-- SEARCH AJAX -->
<!-- ===================================================== -->
@section Scripts {

    <script>

        $(document).ready(function () {

            var typingTimer;

            var delay = 800;


            $("#searchBox").on("keyup", function () {

                clearTimeout(typingTimer);


                var search = $(this).val();


                typingTimer = setTimeout(function () {

                    $.ajax({

                        url: '@Url.Action("OperatorDetailsList", "OperatorDetails")',

                        type: 'GET',

                        data: {
                            search: search,
                            page: 1,
                            pageSize: 15
                        },


                        success: function (data) {

                            // Replace table
                            var result =
                                $(data).find("#operatorTable").html();

                            $("#operatorTable").html(result);


                            // Replace total count
                            var total =
                                $(data).find("#totalCount").html();

                            $("#totalCount").html(total);


                            // Update browser URL
                            var newUrl =
                                '@Url.Action("OperatorDetailsList", "OperatorDetails")'
                                + '?page=1&search='
                                + encodeURIComponent(search);

                            window.history.pushState(
                                {},
                                '',
                                newUrl
                            );

                        },


                        error: function (xhr) {

                            console.log(xhr.responseText);

                            alert("Failed to load data.");

                        }

                    });

                }, delay);

            });

        });

    </script>

}
